theme = "carbonfox"
window-decoration = none
window-width = 120
window-height = 30
window-padding-x = 14
window-padding-y = 2
window-padding-balance = true
background-opacity = 0.85

keybind = ctrl+r=reload_config

keybind = ctrl+f=toggle_fullscreen
keybind = ctrl+a=increase_font_size:1.5
keybind = ctrl+d=decrease_font_size:1.5
